# Juris AI Web Service — Environment Configuration (.env.example)

# Neon pooled PostgreSQL connection string for production.
# Leave unset in local development/test to use @electric-sql/pglite automatically.
DATABASE_URL=

# Database driver: 'pglite' (default when DATABASE_URL is unset) or 'pg'
DB_DRIVER=pglite

# HS256 JWT signing secret for the httpOnly 'juris_session' cookie.
# REQUIRED in production (startup fails if missing). In dev, auto-generated into .data/dev-secret.
JWT_SECRET=

# 32-byte base64-encoded AES-256-GCM key for encrypting integration API keys at rest.
# REQUIRED in production (startup fails if missing). In dev, auto-generated into .data/dev-enc-key.
SETTINGS_ENC_KEY=

# Initial administrator account credentials created by `npm run db:migrate`.
# In dev (when unset), defaults to admin@juris.local / ChangeMe12345 with a console warning.
ADMIN_EMAIL=admin@juris.local
ADMIN_PASSWORD=ChangeMe12345

# Fallback RAG service base URL and API key (overridden when configured in Admin > Integrations > RAG)
RAG_BASE_URL=http://localhost:8001
RAG_API_KEY=dev-rag-key

# Public application brand name
NEXT_PUBLIC_APP_NAME=Juris AI

# Runtime environment: 'development' | 'test' | 'production'
NODE_ENV=development
